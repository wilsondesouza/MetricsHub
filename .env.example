# Copie para .env (nunca comite o .env real)

# local | loopback | token | none
METRICHUB_AUTH_MODE=local
# Obrigatório quando auth_mode=token (mín. 16 caracteres; gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))")
METRICHUB_API_TOKEN=

# Servidor
METRICHUB_HOST=
METRICHUB_PORT=

# Editor SQL livre (desligado por padrão — alto risco em ambientes expostos)
METRICHUB_ALLOW_RAW_SQL=0

# CORS: apenas necessário se o frontend for servido de outra origem
# METRICHUB_CORS_ORIGINS=https://app.exemplo.com

# Caminho alternativo para o config
# METRICHUB_CONFIG=/app/config/config.toml
